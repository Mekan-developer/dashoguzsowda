# Нужен только при запуске socket-server вне Docker.
# В docker-compose переменные приходят из корневого .env.

PORT=3000
# Тот же секрет, что OTP_SECRET в корневом .env и в настройках телефона.
# Без него сервер не стартует.
OTP_SECRET=
# Имя события, которое слушает Flutter SMS-шлюз.
OTP_EVENT_NAME=otp
