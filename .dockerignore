# Что попадает в образ, решает белый список COPY в docker/php/Dockerfile.
# Здесь — что даже не отправлять в контекст сборки: тяжёлое, секретное
# и рантайм-мусор.

.git
node_modules
vendor
public/build
public/hot
public/storage

# Секреты: окружение приходит через env_file, ключ Firebase монтируется
.env
.env.*
storage/app/firebase

# Рантайм
storage
bootstrap/cache/*.php

# Не про PHP-образ
/socket-server
/mobile_docs
/docs
/tests
/bruno
/.claude
/docker-compose*.yml
