# Шаблон .env для локальной разработки в Docker (docker-compose.yml).
# Значения хостов — имена docker-сервисов, менять их не нужно.
# Прод-шаблон: .env.production.example, инструкция: docs/DEPLOY.md

APP_NAME="Daşoguz söwda"
APP_ENV=local
# Заполняется командой: docker compose exec app php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ashgabat
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- База данных (сервис db) ------------------------------------------------
# Учётки должны совпадать с docker/db.env — том с данными создаётся один раз,
# при первом старте контейнера, и потом их уже не перечитывает.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dashoguzsowda
DB_USERNAME=admin
DB_PASSWORD=secret!
DB_ROOT_PASSWORD=root

# --- Redis: кэш, сессии, очереди (сервис redis) -----------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=local

# --- WebSocket-чат, Laravel Reverb (сервис reverb) --------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=123456
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
# Куда backend публикует события — имя docker-сервиса.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Хост для health-check из админки (Настройки → мониторинг).
REVERB_HEALTH_HOST=reverb

# Куда подключается браузер. Порт здесь — тот, что опубликован на хосте
# (docker-compose.override.yml: 8070:8080), а не внутренний REVERB_PORT.
# Для доступа с телефона в той же сети заменить localhost на LAN-адрес компьютера.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8070
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Адрес Vite dev-сервера для браузера (уходит в public/hot и в HMR).
# Для доступа с других машин в локальной сети — LAN-адрес компьютера.
VITE_DEV_HOST=localhost

# --- Почта ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Push-уведомления (FCM) -------------------------------------------------
# Необязательно для локальной разработки: без файла ключа пуши просто
# не отправляются, остальное работает. Файл в git не коммитится.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json

# --- SMS-шлюз (сервис sms-gateway) ------------------------------------------
# По умолчанию log: коды пишутся в storage/logs/laravel.log, телефон не нужен.
# modem — реальная отправка через socket-server.
SMS_DRIVER=log
# Время жизни OTP-кода, секунд.
OTP_TTL=300
# Общий секрет: Laravel ↔ socket-server ↔ телефон-отправитель.
OTP_SECRET=dev-otp-secret
# Адрес шлюза изнутри docker-сети — имя сервиса из docker-compose.yml.
SMS_GATEWAY_URL=http://sms-gateway:3000
SMS_GATEWAY_OTP_EVENT=otp
SMS_GATEWAY_DEVICE_LABEL="Локальный модем"
# Страница-тестер шлюза: http://localhost:3000/test
SMS_GATEWAY_TEST_PAGE=true
