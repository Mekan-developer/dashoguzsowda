meta {
  name: Добавить в избранное
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/favorites
  body: json
}

headers {
  Accept: application/json
  Accept-Language: ru
  Authorization: Bearer {{token}}
}

body:json {
  {
    "listing_id": {{listing_id}}
  }
}

docs {
  Добавляет объявление в избранное. Идемпотентно: повторный вызов
  с тем же listing_id не создаёт дубликата (unique user_id+listing_id).

  В избранное принимается только approved-объявление. На pending/rejected —
  422 (listing_id), даже если id существует: иначе избранное работало бы
  обходным путём к непромодерированному контенту вместе с телефоном продавца.

  Лимит частоты — 60 запросов в минуту (столько же у удаления).
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
