meta {
  name: Получить список регионов
  type: http
  seq: 1
}

get {
  url: {{base_url}}/v1/regions
  body: none
}

headers {
  Accept: application/json
  Accept-Language: ru
}

docs {
  Справочник географии целиком, одним запросом: регионы → города → районы.
  Публичный, нужен формам профиля и создания объявления.

  Скрытые (is_hidden) записи не отдаются на всех трёх уровнях — их же
  не принимают PUT /v1/profile и создание объявления.
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("response has data array", function() {
    expect(res.getBody()).to.have.property('data');
  });

  test("region has cities array", function() {
    const body = res.getBody();
    if (body.data.length > 0) {
      expect(body.data[0]).to.have.property('cities');
      expect(body.data[0]).to.have.property('name_ru');
      expect(body.data[0]).to.have.property('name_tk');
    }
  });

  test("city has districts array", function() {
    const cities = res.getBody().data[0]?.cities ?? [];
    if (cities.length > 0) {
      expect(cities[0]).to.have.property('region_id');
      expect(cities[0]).to.have.property('districts');
    }
  });
}
