meta {
  name: Карточка заказа
  type: http
  seq: 3
}

get {
  url: {{base_url}}/v1/orders/{{order_id}}
  body: none
}

headers {
  Accept: application/json
  Accept-Language: ru
  Authorization: Bearer {{token}}
}

docs {
  Свой заказ целиком. Чужой — 404 (не 403): существование чужих заказов
  не подтверждается.

  В ответе:
  - number — человекочитаемый номер («000017»), по нему покупатель и админ
    находят заказ в разговоре;
  - stores[] — состав по магазинам: у каждого свой status (pending — владелец
    ещё не ответил, accepted — подтвердил, declined — отказался), subtotal
    и items[] со снимком title/unit_price на момент заказа;
  - admin_comment — причина отказа или пометка админа после обзвона;
  - can_cancel — можно ли ещё отменить самому (только пока pending).

  {{order_id}} подставляется из запроса «Оформить заказ».
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("has a number and stores breakdown", function() {
    const data = res.getBody().data;
    expect(data).to.have.property('number');
    expect(data).to.have.property('stores');
  });
}
