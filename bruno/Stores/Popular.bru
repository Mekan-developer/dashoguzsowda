meta {
  name: Популярные магазины
  type: http
  seq: 1
}

get {
  url: {{base_url}}/v1/stores/popular
  body: none
}

headers {
  Accept: application/json
  Accept-Language: ru
  Authorization: Bearer {{token}}
}

docs {
  Витрина на главной (ТЗ §1).

  Отдаются только прошедшие модерацию (status=approved) и не погашенные
  (is_active=1) магазины с is_popular=true, порядок — по sort_order
  (и то и другое ставится вручную в админке: Магазины → «В популярные»
  и стрелки перестановки). Обычный магазин пользователя сюда не попадает,
  пока его не подняли в админке.

  Пагинации нет — отдаётся до 20 магазинов сразу.
  Поля те же, что в карточке магазина: id, name, description, phone,
  sells_retail/sells_wholesale/has_delivery, payment_methods[], address,
  region/city/district, subtitle_tk/subtitle_ru/subtitle (категория магазина),
  logo_url, photos[] (они же photo_urls[] — ссылки на фото галереи).

  Чисто оптовый магазин (sells_retail=0) в эту витрину без
  can_see_wholesale не попадает. Признак: profile.tariff.can_see_wholesale.
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("response has data array", function() {
    expect(res.getBody().data).to.be.an('array');
  });

  test("store card has name and logo fields", function() {
    const data = res.getBody().data;
    if (data.length) {
      expect(data[0]).to.have.property('name');
      expect(data[0]).to.have.property('logo_url');
      expect(data[0]).to.have.property('photos');
    }
  });
}
