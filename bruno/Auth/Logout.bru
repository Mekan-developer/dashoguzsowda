meta {
  name: Выход (отзыв токена)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/v1/auth/logout
  body: json
}

headers {
  Accept: application/json
  Accept-Language: ru
  Authorization: Bearer {{token}}
}

body:json {
  {
    "fcm_token": null
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  fcm_token необязателен. Если передан — этот токен устройства дополнительно
  удаляется из таблицы fcm_tokens (мобильный клиент уже вызвал
  FirebaseMessaging.deleteToken() локально). Пустое тело — отзывается только
  Sanctum-токен, FCM-токены пользователя не трогаются.
}
