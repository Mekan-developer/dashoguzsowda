meta {
  name: Получить опубликованные новости
  type: http
  seq: 1
}

get {
  url: {{base_url}}/v1/news?page=1&limit=20
  body: none
}

params:query {
  ~type: regular
  page: 1
  limit: 20
}

headers {
  Accept: application/json
  Accept-Language: ru
  Authorization: Bearer {{token}}
}

script:post-response {
  // Первая запись списка — в {{news_id}}: карточка и действия берут id отсюда,
  // а не захардкоженный, которого в этой базе может не быть (404)
  if (res.getStatus() === 200) {
    const rows = res.getBody().data;
    if (rows && rows.length) {
      bru.setEnvVar("news_id", rows[0].id);
    }
  }
}

docs {
  Лента новостей.

  Отдаются только опубликованные и уже наступившие: новость с published_at
  в будущем в ленту не попадает, пока время не подошло.

  Фильтры: type (regular|ad), page, limit (1–50, по умолчанию 20).
  Потолок у limit жёсткий: ?limit=1000000 вернёт 422, а не всю таблицу.

  Ответ: { data, meta, links }.
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("response has data array", function() {
    expect(res.getBody()).to.have.property('data');
  });
}
