meta {
  name: Лента роликов (публичная)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/v1/videos?limit=20
  body: none
}

params:query {
  limit: 20
  ~search: 
  ~category_id: 
  ~tag: 
  ~page: 1
}

headers {
  Accept: application/json
  Accept-Language: ru
  Authorization: Bearer {{token}}
}

script:post-response {
  // Первая запись списка — в {{video_id}}: карточка и действия берут id отсюда,
  // а не захардкоженный, которого в этой базе может не быть (404)
  if (res.getStatus() === 200) {
    const rows = res.getBody().data;
    if (rows && rows.length) {
      bru.setEnvVar("video_id", rows[0].id);
    }
  }
}

docs {
  Вертикальная лента (ТЗ §7, экран 9): только approved-ролики,
  сортировка от новых к старым.
  Фильтры (все необязательные, комбинируются):
  - search — поиск по названию
  - category_id — категория 1-го уровня
  - tag — тег
  - limit / page — пагинация
  Пример с заполненными фильтрами — Feed_Search.bru.
  С Bearer-токеном у каждого ролика появляется is_liked.
  В ответе у ролика есть category: { id, name_tk, name_ru }.
  Пока processing=true — video указывает на несжатый оригинал, preview=null.
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("only approved videos", function() {
    res.getBody().data.forEach(v => expect(v.status).to.equal("approved"));
  });
}
