# Прод-окружение. На сервере: cp .env.production.example .env.production
# Из этого файла читают и контейнеры (env_file), и сам Compose (--env-file):
# пароли БД/Redis, OTP_SECRET и VITE_* подставляются в сервисы и сборку.
#
# COMPOSE_PROJECT_NAME не задавать: имя проекта закреплено в
# docker-compose.yml (dashoguzsowda), от него зависят имена томов с базой
# и загрузками. Другое имя — новые пустые тома.

# --- Сборка: зеркала --------------------------------------------------------
# Внешние реестры с сервера закрыты, всё идёт через Nexus. Если Nexus
# недоступен, apt — https://mirror.yandex.ru/debian (медленнее в разы)
APT_MIRROR=https://nexus.telecom.tm/repository/debian-proxy
COMPOSER_MIRROR=https://nexus.telecom.tm/repository/composer-proxy/
NPM_REGISTRY=https://nexus.telecom.tm/repository/npm-proxy/

# uid/gid процессов PHP — владелец файлов в томах. `id -u` / `id -g` на сервере
UID=1000
GID=1000

# --- Приложение -------------------------------------------------------------
APP_NAME="Daşoguz söwda"
APP_ENV=production
# После первой сборки: dc run --rm artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Ashgabat
APP_URL=https://dashoguzsowda.com.tm

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Файлы в storage/logs (том storage_logs), по дню на файл
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- База данных ------------------------------------------------------------
# Те же значения создают пользователя и базу при первом запуске пустого тома
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dashoguzsowda
DB_USERNAME=dzsowda
# openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
# openssl rand -base64 24 — redis-server запускается с этим же паролем
REDIS_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=local

# --- Broadcasting / Reverb --------------------------------------------------
BROADCAST_CONNECTION=reverb
# openssl rand -hex 16 для key и secret; APP_ID — любое число
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Куда backend публикует события — внутри docker-сети
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_HEALTH_HOST=reverb

# Вкомпилируется в JS-бандл: браузер админки ходит в Reverb через
# хостовый nginx по wss://. Поменялись — пересобрать образы (dc build)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=dashoguzsowda.com.tm
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# --- Почта ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@dashoguzsowda.com.tm"
MAIL_FROM_NAME="${APP_NAME}"

# --- Push (FCM) -------------------------------------------------------------
FIREBASE_PROJECT_ID=
# service-account.json положить в /srv/dashoguzsowda/storage/app/firebase/ —
# каталог монтируется в контейнеры read-only
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json

# --- SMS-шлюз ---------------------------------------------------------------
# Время жизни OTP-кода, секунд
OTP_TTL=300
SMS_GATEWAY_URL=http://sms-gateway:3000
SMS_DRIVER=modem
# openssl rand -hex 24 — тот же секрет прописать в телефоне-шлюзе
OTP_SECRET=
SMS_GATEWAY_OTP_EVENT=otp
SMS_GATEWAY_TEST_PAGE=false
SMS_GATEWAY_DEVICE_LABEL="Локальный модем"
