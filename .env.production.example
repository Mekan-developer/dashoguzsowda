APT_MIRROR=https://nexus.telecom.tm/repository/debian-proxy
COMPOSER_MIRROR=https://nexus.telecom.tm/repository/composer-proxy/
NPM_REGISTRY=https://nexus.telecom.tm/repository/npm-proxy/

APP_DOMAIN=dashoguzsowda.com.tm
----------------------------------------------------------
APP_NAME="Daşoguz söwda"
APP_ENV=production
# Обязательно сгенерировать: docker run --rm dzsowda-app:latest php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Ashgabat
APP_URL=https://dashoguzsowda.com.tm

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- База данных ------------------------------------------------------------
DB_CONNECTION=mysql
# Имя сервиса в docker-compose.yml
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dashoguzsowda
DB_USERNAME=dzsowda
# openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
# Обязателен: openssl rand -base64 24
REDIS_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS есть — cookie только по защищённому соединению.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=local

# --- Broadcasting / Reverb --------------------------------------------------
BROADCAST_CONNECTION=reverb
# openssl rand -hex 16 для key и secret; APP_ID — любое число
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Хост, куда backend публикует события (имя docker-сервиса).
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_HEALTH_HOST=reverb

# Что вкомпилируется в JS-бандл: клиент ходит через хостовый nginx по wss://.
# Значения подставляются в build-args автоматически из APP_DOMAIN/REVERB_APP_KEY,
# менять вручную не нужно.

# --- Почта ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@dashoguzsowda.com.tm"
MAIL_FROM_NAME="${APP_NAME}"

# --- Push (FCM) -------------------------------------------------------------
FIREBASE_PROJECT_ID=
# Файл service-account.json положить в storage/app/firebase/ на сервере —
# каталог монтируется в контейнеры read-only.
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json

# --- SMS-шлюз ---------------------------------------------------------------
# Время жизни OTP-кода, секунд.
OTP_TTL=300
SMS_GATEWAY_URL=http://sms-gateway:3000
SMS_DRIVER=modem
OTP_SECRET=
SMS_GATEWAY_OTP_EVENT=otp
SMS_GATEWAY_TEST_PAGE=false
SMS_GATEWAY_DEVICE_LABEL="Локальный модем"
