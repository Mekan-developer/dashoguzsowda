# Шаблон .env для прод-сервера. Скопировать в .env на сервере и заполнить.
# Этот файл читается дважды: docker compose подставляет из него переменные
# (домен, пароли), и он же монтируется в PHP-контейнеры как /var/www/.env.

# --- Сборка образа ----------------------------------------------------------
# Зеркала на случай, когда официальные источники недоступны из сети сервера.
# Пусто = использовать официальные. Проверка доступности — в docs/DEPLOY.md.

# Вместо deb.debian.org (php-стейдж собирается на Debian trixie)
APT_MIRROR=https://nexus.telecom.tm/repository/debian-proxy
# Вместо repo.packagist.org
COMPOSER_MIRROR=https://nexus.telecom.tm/repository/composer-proxy/
# Вместо registry.npmjs.org
NPM_REGISTRY=https://nexus.telecom.tm/repository/npm-proxy/

# --- Домены и TLS -----------------------------------------------------------
# Домен обслуживает админку и мобильное API. OTP-шлюз через него не идёт —
# телефон-шлюз подключается напрямую на порт 3000.
APP_DOMAIN=dashoguzsowda.com.tm

# Собственные сертификаты. Файлы положить в docker/caddy/certs/ на сервере,
# пути ниже — уже внутри контейнера. fullchain.pem = сертификат домена +
# промежуточные сертификаты CA в одном файле.
TLS_CERT=/etc/caddy/certs/fullchain.pem
TLS_KEY=/etc/caddy/certs/privkey.pem

# Нужна только если переключаться на автоматический Let's Encrypt
# (см. комментарии в docker/caddy/Caddyfile).
LETSENCRYPT_EMAIL=

# --- Приложение -------------------------------------------------------------
APP_NAME="Daşoguz söwda"
APP_ENV=production
# Обязательно сгенерировать: docker run --rm dzsowda-app:latest php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Ashgabat
APP_URL=https://dashoguzsowda.com.tm

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- База данных ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dashoguzsowda
DB_USERNAME=dzsowda
# openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Redis (кэш, сессии, очереди) -------------------------------------------
# predis — чистый PHP-клиент (composer.json тянет predis/predis), расширение
# ext-redis (phpredis) в образе не собирается, менять на phpredis нельзя без
# правки docker/php/Dockerfile.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
# Обязателен: openssl rand -base64 24
REDIS_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS есть — cookie только по защищённому соединению.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=local

# --- Broadcasting / Reverb --------------------------------------------------
BROADCAST_CONNECTION=reverb
# openssl rand -hex 16 для key и secret; APP_ID — любое число
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Хост, куда backend публикует события (имя docker-сервиса).
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_HEALTH_HOST=reverb

# Что вкомпилируется в JS-бандл: клиент ходит через Caddy по wss://.
# Значения подставляются в build-args автоматически из APP_DOMAIN/REVERB_APP_KEY,
# менять вручную не нужно.

# --- Почта ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@dashoguzsowda.com.tm"
MAIL_FROM_NAME="${APP_NAME}"

# --- Push (FCM) -------------------------------------------------------------
FIREBASE_PROJECT_ID=
# Файл service-account.json положить в storage/app/firebase/ на сервере —
# каталог монтируется в контейнеры read-only.
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json

# --- SMS-шлюз ---------------------------------------------------------------
# Время жизни OTP-кода, секунд.
OTP_TTL=300
# Адрес шлюза изнутри docker-сети.
SMS_GATEWAY_URL=http://socket:3000
# Чем отправлять коды: modem — через socket-server на телефон (прод),
# log — писать в laravel.log (dev).
SMS_DRIVER=modem
# Общий секрет: сервер ↔ socket-server ↔ телефон-отправитель.
# Одно и то же значение прописывается в настройках телефона.
# ОБЯЗАТЕЛЬНО задать: openssl rand -hex 24
OTP_SECRET=
# Имя socket.io-события, которое слушает телефон.
SMS_GATEWAY_OTP_EVENT=otp
# Страница-тестер шлюза на http://<IP_СЕРВЕРА>:3000/test.
# На проде держать false, включать только на время отладки.
SMS_GATEWAY_TEST_PAGE=false
SMS_GATEWAY_DEVICE_LABEL="Локальный модем"

# --- Документация API -------------------------------------------------------
SCRIBE_AUTH_KEY=
